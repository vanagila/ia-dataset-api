{
  "openapi": "3.0.0",
  "info": {
    "title": "IA Dataset API",
    "version": "1.0.0",
    "description": "API RESTful para ingestão, gerenciamento e consulta de datasets, com autenticação JWT."
  },
  "servers": [
    { "url": "http://localhost:3000" }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "summary": "Registrar novo usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nome": { "type": "string" },
                  "email": { "type": "string" },
                  "senha": { "type": "string" }
                },
                "required": ["nome", "email", "senha"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Usuário registrado com sucesso" },
          "400": { "description": "Dados inválidos" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Login do usuário",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string" },
                  "senha": { "type": "string" }
                },
                "required": ["email", "senha"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login realizado com sucesso" },
          "401": { "description": "Credenciais inválidas" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "summary": "Retorna informações do usuário autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Dados do usuário" },
          "401": { "description": "Token inválido ou ausente" }
        }
      }
    },
    "/datasets/upload": {
      "post": {
        "summary": "Upload de dataset (.csv ou .pdf)",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Arquivo .csv ou .pdf"
                  }
                },
                "required": ["file"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Upload realizado com sucesso" },
          "400": { "description": "Arquivo inválido" },
          "401": { "description": "Token inválido ou ausente" }
        }
      }
    },
    "/datasets": {
      "get": {
        "summary": "Listar datasets do usuário autenticado",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Lista de datasets" },
          "401": { "description": "Token inválido ou ausente" }
        }
      }
    },
    "/datasets/{id}/records": {
      "get": {
        "summary": "Listar registros de um dataset",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Lista de registros" },
          "401": { "description": "Token inválido ou ausente" },
          "404": { "description": "Dataset não encontrado" }
        }
      }
    },
    "/records/search": {
      "get": {
        "summary": "Busca textual por palavra-chave nos registros",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Resultados da busca" },
          "401": { "description": "Token inválido ou ausente" }
        }
      }
    },
    "/queries": {
      "get": {
        "summary": "Listar histórico de buscas simuladas via IA",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Histórico de queries" },
          "401": { "description": "Token inválido ou ausente" }
        }
      },
      "post": {
        "summary": "Registrar uma busca simulada via IA",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "pergunta": { "type": "string" },
                  "datasetId": { "type": "string" }
                },
                "required": ["pergunta", "datasetId"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Busca registrada com sucesso" },
          "401": { "description": "Token inválido ou ausente" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}